{
  "schemaVersion": "1.7.0",
  "id": "doc-estilo",
  "siteName": "Reformas Vega",
  "theme": {
    "color.primary": "#1D4ED8",
    "color.secondary": "#0F766E",
    "color.accent": "#D97706",
    "color.surface": "#FFFFFF",
    "color.ink": "#0F172A",
    "color.muted": "#475569",
    "font.heading": "Georgia, serif",
    "font.body": "system-ui, sans-serif",
    "size.heading": "2.5rem",
    "size.subheading": "1.5rem",
    "size.body": "1rem",
    "space.xs": "4px",
    "space.sm": "8px",
    "space.md": "16px",
    "space.lg": "24px",
    "space.xl": "48px",
    "radius.sm": "4px",
    "radius.md": "8px",
    "radius.lg": "16px"
  },
  "pages": [
    {
      "id": "home",
      "slug": "index",
      "title": "Reformas Vega",
      "sections": [
        {
          "id": "sec-cover",
          "preset": {
            "catalogId": "cover",
            "variantId": "image-right"
          },
          "source": "catalog",
          "layout": null,
          "content": [
            {
              "id": "el-headline",
              "role": "heading",
              "hidden": false,
              "slot": "headline",
              "value": {
                "kind": "text",
                "text": "Reformamos tu casa sin sorpresas"
              },
              "style": {
                "color": {
                  "ref": "color.ink"
                },
                "fontSize": {
                  "ref": "size.subheading"
                }
              }
            },
            {
              "id": "el-subheadline",
              "role": "subheading",
              "hidden": false,
              "slot": "subheadline",
              "value": {
                "kind": "text",
                "text": "Presupuesto cerrado y fecha de entrega por escrito"
              },
              "style": {
                "color": {
                  "ref": "color.muted"
                },
                "fontFamily": {
                  "ref": "font.heading"
                }
              }
            },
            {
              "id": "el-body",
              "role": "body",
              "hidden": false,
              "slot": "body",
              "value": {
                "kind": "text",
                "text": "Cocinas, baños y viviendas completas en Ronda y alrededores."
              }
            },
            {
              "id": "el-image",
              "role": "image",
              "hidden": false,
              "slot": "image",
              "value": {
                "kind": "image",
                "src": "assets/physio.svg",
                "alt": "Una cocina recién reformada"
              },
              "style": {
                "borderRadius": {
                  "exact": "28px",
                  "exception": true
                }
              }
            },
            {
              "id": "el-secondary",
              "role": "link",
              "hidden": false,
              "slot": "secondaryAction",
              "value": {
                "kind": "link",
                "text": "Ver trabajos",
                "href": "#trabajos"
              },
              "style": {
                "color": {
                  "ref": "color.secondary"
                }
              }
            },
            {
              "id": "el-oculto",
              "role": "body",
              "hidden": true,
              "slot": "body",
              "value": {
                "kind": "text",
                "text": "Este texto está oculto y su estilo no debe publicarse."
              },
              "style": {
                "color": {
                  "exact": "#FF00FF",
                  "exception": true
                }
              }
            }
          ]
        },
        {
          "id": "sec-services",
          "preset": {
            "catalogId": "services",
            "variantId": "stacked"
          },
          "source": "catalog",
          "layout": null,
          "content": [
            {
              "id": "el-services-headline",
              "role": "heading",
              "hidden": false,
              "slot": "headline",
              "value": {
                "kind": "text",
                "text": "Qué hacemos"
              }
            },
            {
              "id": "el-services",
              "role": "list",
              "hidden": false,
              "slot": "services",
              "items": [
                {
                  "id": "item-1",
                  "elements": [
                    {
                      "id": "el-card-1-title",
                      "role": "heading",
                      "hidden": false,
                      "slot": "title",
                      "value": {
                        "kind": "text",
                        "text": "Cocinas"
                      },
                      "style": {
                        "color": {
                          "exact": "#7A1F1F",
                          "exception": true
                        },
                        "padding": {
                          "ref": "space.sm"
                        },
                        "fontFamily": {
                          "ref": "font.body"
                        }
                      }
                    },
                    {
                      "id": "el-card-1-description",
                      "role": "body",
                      "hidden": false,
                      "slot": "description",
                      "value": {
                        "kind": "text",
                        "text": "De la demolición al último tirador."
                      }
                    }
                  ]
                },
                {
                  "id": "item-2",
                  "elements": [
                    {
                      "id": "el-card-2-title",
                      "role": "heading",
                      "hidden": false,
                      "slot": "title",
                      "value": {
                        "kind": "text",
                        "text": "Baños"
                      },
                      "style": {
                        "fontFamily": {
                          "ref": "font.body"
                        }
                      }
                    },
                    {
                      "id": "el-card-2-description",
                      "role": "body",
                      "hidden": false,
                      "slot": "description",
                      "value": {
                        "kind": "text",
                        "text": "Platos de ducha, alicatado y fontanería."
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "collections": []
}
