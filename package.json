{
  "name": "retorika-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Professional websites for small businesses in under ten minutes",
  "engines": {
    "node": "^24.21.0",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "test": "vitest run",
    "test:invariants": "vitest run -t INV_",
    "test:golden": "vitest run golden",
    "test:a11y": "RETORIKA_A11Y=1 vitest run --project a11y --maxWorkers 2",
    "test:coverage": "vitest run --coverage",
    "e2e": "RETORIKA_E2E=1 vitest run --project e2e --maxWorkers 1",
    "test:db": "RETORIKA_DB=1 vitest run --project db-pg --maxWorkers 1",
    "lighthouse": "RETORIKA_LIGHTHOUSE=1 vitest run --project lighthouse --maxWorkers 1",
    "typecheck": "tsc --build --force && tsc --noEmit -p apps/editor/tsconfig.json",
    "build:editor": "pnpm --filter @retorika/editor build",
    "lint": "biome check --max-diagnostics=500 .",
    "format": "biome check --write .",
    "size": "node scripts/size-budget.ts",
    "schema:guard": "node scripts/schema-guard.ts",
    "schema:snapshot": "node scripts/schema-snapshot.ts",
    "renderer:deps": "node scripts/renderer-deps.ts",
    "secrets:scope": "node scripts/secrets-scope.ts",
    "accounts:purge": "node scripts/purge-accounts.ts",
    "site:sample": "node scripts/build-sample-site.ts",
    "coverage:ratchet": "node scripts/coverage-ratchet.ts",
    "audit:exceptions": "node scripts/audit-exceptions.ts",
    "security:audit": "node scripts/security-audit.ts",
    "security:secrets": "pre-commit run gitleaks --all-files",
    "fonts:generate": "node scripts/generate-font-data.ts",
    "fonts:licences": "node scripts/fetch-font-licences.ts",
    "fonts:survey": "node scripts/survey-fonts.ts",
    "brand:assets": "node scripts/brand-assets.ts",
    "brand:vector": "node scripts/brand-vector.ts",
    "photos:intake": "node packages/photobank/tools/intake-cli.ts",
    "photos:approve": "node packages/photobank/tools/approve-cli.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@fontsource/inter": "5.2.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.13.0",
    "chrome-launcher": "1.2.2",
    "fast-check": "4.10.1",
    "happy-dom": "21.0.4",
    "lighthouse": "13.5.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/aleo": "5.3.0",
    "@fontsource/bitter": "5.3.0",
    "@fontsource/crimson-pro": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/gelasio": "5.3.0",
    "@fontsource/karla": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "@fontsource/libre-franklin": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/rokkitt": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@retorika/db": "workspace:*",
    "@retorika/generator": "workspace:*",
    "@retorika/photobank": "workspace:*",
    "@retorika/publisher": "workspace:*",
    "@retorika/renderer": "workspace:*",
    "@retorika/schema": "workspace:*",
    "@supabase/supabase-js": "2.117.2"
  }
}
