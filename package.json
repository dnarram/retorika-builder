{
  "name": "retorika-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Professional websites for small businesses in under ten minutes",
  "engines": {
    "node": "^24.21.0",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "test": "vitest run",
    "test:invariants": "vitest run -t INV_",
    "test:golden": "vitest run golden",
    "test:a11y": "RETORIKA_A11Y=1 vitest run --project a11y --maxWorkers 2",
    "test:coverage": "vitest run --coverage",
    "e2e": "RETORIKA_E2E=1 vitest run --project e2e --maxWorkers 1",
    "test:db": "RETORIKA_DB=1 vitest run --project db-pg --maxWorkers 1",
    "typecheck": "tsc --build --force && tsc --noEmit -p apps/editor/tsconfig.json",
    "build:editor": "pnpm --filter @retorika/editor build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "size": "node scripts/size-budget.ts",
    "schema:guard": "node scripts/schema-guard.ts",
    "schema:snapshot": "node scripts/schema-snapshot.ts",
    "renderer:deps": "node scripts/renderer-deps.ts",
    "secrets:scope": "node scripts/secrets-scope.ts",
    "accounts:purge": "node scripts/purge-accounts.ts",
    "site:sample": "node scripts/build-sample-site.ts",
    "coverage:ratchet": "node scripts/coverage-ratchet.ts",
    "audit:exceptions": "node scripts/audit-exceptions.ts",
    "security:audit": "node scripts/security-audit.ts",
    "security:secrets": "pre-commit run gitleaks --all-files",
    "fonts:generate": "node scripts/generate-font-data.ts",
    "brand:assets": "node scripts/brand-assets.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@fontsource/inter": "5.2.8",
    "@fontsource/playfair-display": "5.2.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "fast-check": "4.10.1",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@retorika/db": "workspace:*",
    "@retorika/publisher": "workspace:*",
    "@retorika/renderer": "workspace:*",
    "@retorika/schema": "workspace:*"
  }
}
